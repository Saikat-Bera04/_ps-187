# ─── IBVAP Backend Environment Variables ─────────────────

# Server
PORT=4000
NODE_ENV=development

# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Authentication
JWT_SECRET="your-super-secret-jwt-key-min-32-chars-long"
JWT_REFRESH_SECRET="your-refresh-token-secret-min-32-chars"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# Camera Credential Encryption (AES-256-GCM)
ENCRYPTION_KEY="your-32-byte-hex-encryption-key-here-64-hex-chars"

# Redis (for rate limiting; falls back to in-memory if unavailable)
REDIS_URL="redis://localhost:6379"

# AI Service
AI_MODE="mock"           # "mock" or "service"
AI_SERVICE_URL="http://localhost:8000"
AI_SERVICE_TIMEOUT=5000

# Storage (MinIO / Local)
STORAGE_MODE="local"     # "minio" or "local"
MINIO_ENDPOINT="localhost"
MINIO_PORT=9000
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_BUCKET="ibvap-evidence"
MINIO_USE_SSL=false
LOCAL_STORAGE_PATH="./storage"

# Blockchain
BLOCKCHAIN_MODE="mock"   # "mock" or "fabric"
FABRIC_GATEWAY_URL=""
FABRIC_CHANNEL="evidence-channel"
FABRIC_CHAINCODE="ibvap-evidence-cc"

# CORS
CORS_ORIGIN="http://localhost:3000"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=10
